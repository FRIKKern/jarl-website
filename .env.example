# Barkpark content API — see README "Env manifest" for the authoritative list.
# Copy to .env.local (gitignored) and fill in the real token.

# Base URL of the dedicated Barkpark instance (no trailing slash)
BARKPARK_URL=https://jarl.barkpark.cloud

# READ-ONLY workspace-bound token, minted with:
#   bp -s https://jarl.barkpark.cloud --token "$ADMIN_TOKEN" token create jarl-website-read
# Never commit the value. In CI it is provided as the BARKPARK_READ_TOKEN secret.
BARKPARK_READ_TOKEN=
